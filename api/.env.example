# Copy to api/.env. Never commit .env. Run `uv run python scripts/init_secret.py` to generate
# API_SHARED_SECRET (it must equal the one in web/.env.local). OPENROUTER_API_KEY may instead
# live in the project-root .env; api/.env wins when both set a variable.

# Required
OPENROUTER_API_KEY=
API_SHARED_SECRET=

# Optional. Leave a line commented out to use the built-in default.
# Only shows multi-provider support on the Studio page. Sagaloom never sends a request to Gemini.
# GEMINI_API_KEY=
# Default for every role is openai/gpt-6-luna; each model must be in sagaloom/allowed_models.json.
# CHAT_MODEL=
# JUDGE_MODEL=
# EXTRACTOR_MODEL=
# GUARD_MODEL=
# PROVIDER_ORDER=
# EMBED_MODEL=
# OPENROUTER_BASE_URL=
# WEB_ORIGIN=
# DATA_DIR=
# PRICE_IN_PER_MTOK=
# PRICE_OUT_PER_MTOK=

# LangSmith tracing is read from the process environment, NOT from this file (the settings
# loader only reads the fields above). Export these in the shell that starts the API:
#   LANGSMITH_TRACING=true
#   LANGSMITH_API_KEY=
#   LANGSMITH_PROJECT=sagaloom
