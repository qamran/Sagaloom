# Copy to api/.env. Never commit .env. Run `uv run python scripts/init_secret.py` to generate
# API_SHARED_SECRET (it must equal the one in web/.env.local). OPENROUTER_API_KEY may instead
# live in the project-root .env; api/.env wins when both set a variable.

# Required
OPENROUTER_API_KEY=
API_SHARED_SECRET=

# Sign-in (Clerk; see README "Accounts (Clerk)"). Without CLERK_ISSUER every signed-in request
# gets 503; without CLERK_SECRET_KEY new users get 503. These may live in the project-root .env.
# CLERK_ISSUER is the instance's Frontend API URL, e.g. https://<your-app>.clerk.accounts.dev
CLERK_ISSUER=
CLERK_SECRET_KEY=
# The account whose Clerk-verified primary email equals this is the admin.
ADMIN_EMAIL=

# Optional. Leave a line commented out to use the built-in default.
# Only shows multi-provider support on the Studio page. Sagaloom never sends a request to Gemini.
# GEMINI_API_KEY=
# Default for every role is openai/gpt-6-luna; each model must be in sagaloom/allowed_models.json
# (the API refuses to start otherwise).
# CHAT_MODEL=
# JUDGE_MODEL=
# EXTRACTOR_MODEL=
# GUARD_MODEL=
# PROVIDER_ORDER=
# EMBED_MODEL=
# OPENROUTER_BASE_URL=
# WEB_ORIGIN=
# Socket addresses whose X-Forwarded-For the rate limiter believes, as a JSON list. Empty (the
# default) keys every request by its socket peer. Example: TRUSTED_PROXIES=["10.0.0.5"]
# TRUSTED_PROXIES=[]
# DATA_DIR=
# PRICE_IN_PER_MTOK=
# PRICE_OUT_PER_MTOK=

# Optional LangSmith tracing. The API exports this file to the process environment at startup,
# so the tracer picks these up (a variable already set in the shell wins).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=sagaloom
