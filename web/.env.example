# Copy to web/.env.local. Never commit .env.local. Only Clerk's publishable key may start with
# NEXT_PUBLIC_ (it is meant for the browser); everything else stays on the server, and the
# /api/proxy route adds the shared secret.
API_SHARED_SECRET=
# Clerk (see README "Accounts (Clerk)"): the application's publishable and secret keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Where the API runs (default http://localhost:8000).
# API_URL=
# Pass the incoming X-Forwarded-For on to the API (default: dropped). Set to true only when an
# edge in front of this server overwrites or appends the caller's address; a browser can forge it.
# TRUST_FORWARDED_FOR=true
